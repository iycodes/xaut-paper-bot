# Use credentials belonging to a Bitfinex PAPER-TRADING subaccount only.
# The application verifies Bitfinex's PPT_ENABLED flag before authenticated use.
BITFINEX_API_KEY=
BITFINEX_API_SECRET=

# Leave blank for observe-only operation. For paper-order mode, this must match
# the exact acknowledgement configured in configs/config.json.
BFX_PAPER_TRADING_ACK=
